# ─────────────────────────────────────────────────────────────
# Beam environment configuration
# Copy to `.env` and adjust. The server reads these at boot.
# The client reads VITE_* vars (see packages/client).
# ─────────────────────────────────────────────────────────────

# ── Server (packages/server) ──────────────────────────────────
PORT=8787
HOST=0.0.0.0

# Rooms live in memory by default (one instance, nothing else to run).
# Set REDIS_URL to share rooms between several instances behind a load
# balancer; then also set the same SESSION_SECRET (≥16 chars) on each.
# REDIS_URL=redis://localhost:6379
# SESSION_SECRET=

# Ephemeral room time-to-live, in seconds (rooms auto-expire).
ROOM_TTL_SECONDS=3600

# Comma-separated CORS origins allowed to reach the signaling server.
CORS_ORIGINS=http://localhost:5173

# ── ICE / NAT traversal ───────────────────────────────────────
# STUN is always used (public servers by default).
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN is OPTIONAL. Leave blank to run STUN-only.
# When all three are set, the server hands TURN creds to clients,
# which makes transfers work behind symmetric NAT / CGNAT.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Encrypted WebSocket relay used when peers can't connect directly and TURN
# doesn't help. The server only ever relays ciphertext, but it costs your
# bandwidth. "false" disables it.
RELAY_ENABLED=true

# Receivers that can download from one link at the same time.
MAX_RECEIVERS=8

# Serve the built web app from the server too (single-process deploys).
# STATIC_DIR=packages/client/dist

# ── Client (packages/client) ──────────────────────────────────
# Base URL of the signaling server, as reached from the browser. Leave empty
# when the server also serves the app (same origin).
VITE_SIGNALING_URL=http://localhost:8787
